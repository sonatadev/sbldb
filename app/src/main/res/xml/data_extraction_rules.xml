<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the database and settings to the cloud and on device transfer.
     The downloaded content cache is skipped because the app fetches it again from GitHub. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="content/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="content/" />
    </device-transfer>
</data-extraction-rules>
